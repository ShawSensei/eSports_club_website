# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is already in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-side only

# ── Site URL ──────────────────────────────────────────────────────────────────
# Local dev:    http://localhost:3000
# Production:   https://your-vercel-or-custom-domain.com  (must be HTTPS, no trailing slash)
# Also set this in: Supabase → Authentication → URL Configuration → Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Dashboard → Settings → Access Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret   # server-side only
